generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── DOMAINES DE RÉFÉRENCE ──────────────────────────────────────────────────
model Domain {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  label       String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

// ─── UTILISATEURS ───────────────────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  xp        Int      @default(0)
  role      String   @default("UTILISATEUR")
  answers   Json?    // Stocke les réponses d'identification (Stage 2)

  // Relations
  domainId  Int
  domain    Domain     @relation(fields: [domainId], references: [id])

  // MODIFICATION : Utilisation de Progress[] (Tableau) pour autoriser
  // plusieurs lignes de progression par utilisateur (HTML, CSS, JS...)
  progress  Progress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── PROGRESSION PAR SECTEUR ────────────────────────────────────────────────
model Progress {
  id            Int      @id @default(autoincrement())
  currentStep   Int      @default(1)
  score         Int      @default(0)
  completed     Boolean  @default(false)
  lastActivity  DateTime @default(now()) @updatedAt

  // IDENTIFICATION DU SECTEUR
  // Permet de séparer les niveaux (ex: HTML niveau 4, CSS niveau 1)
  domain        String   @default("html")

  // RELATION AVEC L'UTILISATEUR
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // CONTRAINTE D'UNICITÉ COMPOSÉE
  // Empêche d'avoir deux lignes HTML pour le même utilisateur.
  // Génère automatiquement l'index "userId_domain" pour les requêtes upsert.
  @@unique([userId, domain])
}