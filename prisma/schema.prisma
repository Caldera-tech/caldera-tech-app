generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Domain {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  label       String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  xp        Int      @default(0)
  role      String   @default("UTILISATEUR")
  answers   Json?    // Stocke les réponses d'identification (Stage 2)

  // Relations
  domainId  Int
  domain    Domain   @relation(fields: [domainId], references: [id])
  progress  Progress?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Progress {
  id            Int      @id @default(autoincrement())
  currentStep   Int      @default(1)
  score         Int      @default(0)
  completed     Boolean  @default(false)
  lastActivity  DateTime @default(now()) @updatedAt

  // Relation 1-to-1 stricte avec l'utilisateur
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}